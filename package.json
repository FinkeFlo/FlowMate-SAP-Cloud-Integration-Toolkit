{
  "name": "flowmate-sap-cpi-toolkit",
  "description": "FlowMate - Your SAP CPI Productivity Toolkit",
  "private": false,
  "version": "0.1.0",
  "author": "FK",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:design": "design.md lint DESIGN.md",
    "playwright:session": "node scripts/playwright-session.mjs",
    "playwright:session:smoke": "FLOWMATE_PLAYWRIGHT_HEADLESS=true FLOWMATE_PLAYWRIGHT_KEEP_OPEN=false FLOWMATE_PLAYWRIGHT_WAIT_MS=3000 node scripts/playwright-session.mjs",
    "postinstall": "wxt prepare",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run compile && npm run lint && npm run lint:design && npm run lint:i18n && npm run test && npm run build",
    "lint:i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "^0.4.0",
    "@preact/preset-vite": "^2.10.3",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/sortablejs": "^1.15.9",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "release-it": "^21.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.3",
    "lucide-preact": "^1.61.0",
    "preact": "^11.0.2",
    "sortablejs": "^1.15.7"
  },
  "overrides": {
    "undici": "^8.11.2",
    "basic-ftp": "^6.2.2"
  }
}
