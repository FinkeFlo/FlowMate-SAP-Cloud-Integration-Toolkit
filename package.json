{
  "name": "flowmate-sap-cpi-toolkit",
  "description": "FlowMate - Your SAP CPI Productivity Toolkit",
  "private": false,
  "version": "0.1.0",
  "author": "FK",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:design": "design.md lint DESIGN.md",
    "playwright:session": "node scripts/playwright-session.mjs",
    "playwright:session:smoke": "FLOWMATE_PLAYWRIGHT_HEADLESS=true FLOWMATE_PLAYWRIGHT_KEEP_OPEN=false FLOWMATE_PLAYWRIGHT_WAIT_MS=3000 node scripts/playwright-session.mjs",
    "postinstall": "wxt prepare",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/sortablejs": "^1.15.9",
    "daisyui": "^5.7.47",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "release-it": "^21.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@preact/preset-vite": "^2.10.3",
    "lucide-preact": "^1.50.0",
    "preact": "^11.0.0",
    "sortablejs": "^1.15.7"
  }
}
